# Normalize line endings. PowerShell files on Windows ship with CRLF.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

*.cmd  text eol=crlf
*.bat  text eol=crlf

*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.cab binary
*.exe binary
*.lnk binary

# Diff drivers
*.ps1  diff=powershell
*.psm1 diff=powershell
*.psd1 diff=powershell
