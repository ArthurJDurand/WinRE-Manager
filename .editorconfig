root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.psm1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.psd1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{cmd,bat}]
charset = utf-8
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# These three markdown files are CRLF per the project encoding table,
# unlike the remaining docs/*.md files which are LF.
[README.md]
end_of_line = crlf

[docs/architecture.md]
end_of_line = crlf

[docs/index.md]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
