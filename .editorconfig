root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.psm1]
end_of_line = crlf
indent_size = 4

[*.psd1]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
